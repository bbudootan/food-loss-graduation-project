        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% JEC Food Rescue 共通レイアウトの主な導線（企業レビュー補足用）\n%% 根拠: prototype/user-frontend-v1 / commit e06f1460b204ded0a00f5098023dcc2abb162cc1\n%% 複数の画面をまとめたノードは、個別ページの一覧を表します。\n%% 通知・カートは、未ログイン時に各ドロワーを開いてログイン／新規登録を案内します。\n%% 会員機能とゲーム画面・モーダルには、詳細設計や実装が未完了のものがあります。\n%%{init: {\&quot;theme\&quot;:\&quot;base\&quot;, \&quot;flowchart\&quot;:{\&quot;curve\&quot;:\&quot;basis\&quot;,\&quot;nodeSpacing\&quot;:35,\&quot;rankSpacing\&quot;:65}, \&quot;themeVariables\&quot;:{\&quot;fontFamily\&quot;:\&quot;sans-serif\&quot;,\&quot;fontSize\&quot;:\&quot;18px\&quot;,\&quot;primaryTextColor\&quot;:\&quot;#19333a\&quot;,\&quot;lineColor\&quot;:\&quot;#567079\&quot;}}}%%\nflowchart LR\n    layout[\&quot;共通レイアウト\&quot;]\n    nav[\&quot;ヘッダー中央\&quot;]\n    homepage[\&quot;ホーム\&quot;]\n    map[\&quot;地図で探そう\&quot;]\n    productList[\&quot;商品一覧\&quot;]\n    storeList[\&quot;店舗一覧\&quot;]\n    noticeDrawer[\&quot;通知ドロワー\&quot;]\n    noticeList[\&quot;通知一覧\&quot;]\n    cartDrawer[\&quot;カートドロワー\&quot;]\n    cart[\&quot;カート全体\&quot;]\n    checkout[\&quot;注文確認\&quot;]\n    accountDrawer[\&quot;アカウントドロワー\&quot;]\n    guest[\&quot;ログイン・新規登録\&quot;]\n    member[\&quot;マイページ・お気に入り・注文履歴・ポイント・設定\&quot;]\n    support[\&quot;ガイド・FAQ・お問い合わせ\&quot;]\n    footer[\&quot;共通フッター\&quot;]\n    legal[\&quot;利用規約・プライバシーポリシー・運営について\&quot;]\n\n    layout --&gt; nav\n    nav --&gt; homepage\n    nav --&gt; map\n    nav --&gt; productList\n    nav --&gt; storeList\n    layout --&gt; noticeDrawer\n    layout --&gt; cartDrawer\n    layout --&gt; accountDrawer\n    noticeDrawer --&gt;|\&quot;ログイン済み\&quot;| noticeList\n    noticeDrawer -.-&gt;|\&quot;未ログイン\&quot;| guest\n    cartDrawer --&gt;|\&quot;ログイン済み\&quot;| cart\n    cartDrawer --&gt;|\&quot;ログイン済み・直接注文\&quot;| checkout\n    cartDrawer -.-&gt;|\&quot;未ログイン\&quot;| guest\n    accountDrawer --&gt;|\&quot;未ログイン\&quot;| guest\n    accountDrawer --&gt;|\&quot;ログイン済み\&quot;| member\n    accountDrawer --&gt;|\&quot;共通\&quot;| support\n    layout --&gt; footer\n    footer --&gt; legal\n\n    classDef frame fill:#F3F6F6,stroke:#A5B5B7,color:#203C41,stroke-width:2px\n    classDef drawer fill:#E4F1F3,stroke:#3A7A86,color:#17363D,stroke-width:2px\n    classDef screen fill:#FFFFFF,stroke:#849B9E,color:#17363D,stroke-width:2px\n    classDef member fill:#F1F7ED,stroke:#829D78,color:#243C27,stroke-width:2px\n    class layout,nav,footer frame\n    class noticeDrawer,cartDrawer,accountDrawer drawer\n    class homepage,map,productList,storeList,noticeList,cart,checkout,guest,support,legal screen\n    class member member\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="37">
